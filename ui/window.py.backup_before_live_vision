    def reaction_path(self, emotion):
        root = Path(__file__).resolve().parents[1]
        return root / "assets" / "reactions" / self.REACTIONS.get(
            emotion, "neutral.png"
        )

    def set_emotion(self, emotion):
        if emotion not in self.REACTIONS:
            emotion = "neutral"

        path = self.reaction_path(emotion)
        pixmap = QPixmap(str(path))

        if pixmap.isNull():
            self.image_label.setText(f"Missing reaction image:\n{path.name}")
            return

        max_width = 420
        max_height = 500
        pixmap = pixmap.scaled(
            max_width,
            max_height,
            Qt.KeepAspectRatio,
            Qt.SmoothTransformation,
        )
        self.image_label.setPixmap(pixmap)
        self.image_label.adjustSize()
        self.adjustSize()

        self.state.data["emotion"] = emotion
        self.state.data["mood"] = self.mood_for_emotion(emotion)
        self.state.save()

    @staticmethod
    def mood_for_emotion(emotion):
        return {
            "happy": "happy",
            "shocked": "startled",
            "neutral": "neutral",
        }.get(emotion, "neutral")

    # ---------- Interaction / conversation ----------

    def register_interaction(self):
        self.last_interaction = time.monotonic()
        self.idle_started_at = None
        self.idle_spoke = False
        self.idle_moved = False

        self.state.data["activity"] = "talking"
        self.state.save()

    def send_message(self):
        text = self.input_box.text().strip()
        if not text or self.worker is not None:
            return

        self.register_interaction()
        self.input_box.clear()
        self.chat_box.append(f"<b>You:</b> {text}")

        self.talk_button.setEnabled(False)
        self.input_box.setEnabled(False)
        self.state.data["activity"] = "thinking"

        self.worker = BrainWorker(self.brain, user_text=text)
        self.worker.finished.connect(self.on_brain_result)
        self.worker.failed.connect(self.on_brain_error)
        self.worker.finished.connect(self.cleanup_worker)
        self.worker.failed.connect(self.cleanup_worker)
        self.worker.start()

    def on_brain_result(self, result):
        message = str(result.get("message", "..."))
        emotion = str(result.get("emotion", "neutral"))
        self.chat_box.append(f"<b>Saphira:</b> {message}")
        self.set_emotion(emotion)
        self.state.data["activity"] = "talking"
        self.state.save()

    def on_brain_error(self, error):
        self.chat_box.append(f"<b>Saphira:</b> Hmph... {error}")
        self.set_emotion("neutral")

    def cleanup_worker(self, *_):
        if self.worker:
            self.worker.deleteLater()
        self.worker = None
        self.talk_button.setEnabled(True)
        self.input_box.setEnabled(True)
        self.input_box.setFocus()

    # ---------- Idle behavior ----------

    def update_behavior(self):
        elapsed_ms = int((time.monotonic() - self.last_interaction) * 1000)

        if elapsed_ms < self.IDLE_AFTER_MS:
            return

        if self.idle_started_at is None:
            self.idle_started_at = time.monotonic()
            self.idle_spoke = False
            self.idle_moved = False
            self.state.data["activity"] = "idle"
            self.state.save()

            # Randomly settle into one of the moods that the current art supports.
            idle_emotion = random.choices(
                ["neutral", "happy", "shocked"],
                weights=[55, 35, 10],
                k=1,
            )[0]
            self.set_emotion(idle_emotion)

        idle_elapsed_ms = int((time.monotonic() - self.idle_started_at) * 1000)

        # Give her time to become idle before she decides to move somewhere
        # more comfortable.
        if idle_elapsed_ms >= 45_000 and not self.idle_moved:
            self.idle_moved = True
            self.state.data["activity"] = "wandering"
            self.move_to_comfortable_position()

        # At 60 seconds of total inactivity, let her start a conversation.
        if idle_elapsed_ms >= self.IDLE_SPEAK_AFTER_MS and not self.idle_spoke:
            self.idle_spoke = True
            self.state.data["activity"] = "idle_talking"
            self.state.save()
            self.start_idle_conversation()

    def start_idle_conversation(self):
        if self.worker is not None:
            return

        recent = "\n".join(
            f"{m.get('role', '')}: {m.get('content', '')}"
            for m in self.brain.history[-6:]
        )

        self.worker = BrainWorker(
            self.brain,
            idle=True,
            context=recent,
        )
        self.worker.finished.connect(self.on_idle_result)
        self.worker.failed.connect(self.on_idle_error)
        self.worker.finished.connect(self.cleanup_worker)
        self.worker.failed.connect(self.cleanup_worker)
        self.worker.start()

    def on_idle_result(self, result):
        message = str(result.get("message", "..."))
        emotion = str(result.get("emotion", "neutral"))
        self.chat_box.append(f"<b>Saphira:</b> {message}")
        self.set_emotion(emotion)
        self.state.data["activity"] = "idle"
        self.state.save()

    def on_idle_error(self, _error):
        self.chat_box.append("<b>Saphira:</b> You're awfully quiet over there...")
        self.set_emotion("neutral")

    # ---------- Position / movement ----------

    def load_saved_position(self):
        x = self.state.data.get("preferred_x")
        y = self.state.data.get("preferred_y")

        screen = QApplication.primaryScreen()
        if screen is None:
            return

        area = screen.availableGeometry()

        if x is None or y is None:
            x = area.right() - self.width() - 30
            y = area.bottom() - self.height() - 30

        x = max(area.left(), min(int(x), area.right() - self.width()))
        y = max(area.top(), min(int(y), area.bottom() - self.height()))
        self.move(x, y)

    def save_preferred_position(self):
        self.state.set_position(self.x(), self.y())

    def safe_position(self, x, y):
        screen = QApplication.primaryScreen()
        if screen is None:
            return QPoint(x, y)

        area = screen.availableGeometry()
        x = max(area.left(), min(int(x), area.right() - self.width()))
        y = max(area.top(), min(int(y), area.bottom() - self.height()))
        return QPoint(x, y)

    def move_smoothly(self, target, duration=550):
        target = self.safe_position(target.x(), target.y())

        if self.flee_animation:
            self.flee_animation.stop()
            self.flee_animation.deleteLater()

        animation = QPropertyAnimation(self, b"pos", self)
        animation.setDuration(duration)
        animation.setStartValue(self.pos())
        animation.setEndValue(target)
        animation.setEasingCurve(QEasingCurve.OutCubic)

        self.flee_animation = animation
        animation.finished.connect(self.on_movement_finished)
        animation.start()

    def on_movement_finished(self):
        if self.flee_animation:
            self.flee_animation.deleteLater()
            self.flee_animation = None

        self.state.data["activity"] = "idle"
        self.state.save()

    def move_to_comfortable_position(self):
        screen = QApplication.primaryScreen()
        if screen is None:
            return

        area = screen.availableGeometry()

        # Choose a nearby, comfortable desktop position instead of making
        # huge jumps. Keep clear of the edges.
        margin = 30
        candidates = [
            QPoint(area.left() + margin, area.bottom() - self.height() - margin),
            QPoint(area.right() - self.width() - margin, area.bottom() - self.height() - margin),
            QPoint(area.left() + margin, area.top() + margin),
            QPoint(area.right() - self.width() - margin, area.top() + margin),
        ]

        current = self.pos()
        candidates.sort(
            key=lambda p: abs(p.x() - current.x()) + abs(p.y() - current.y())
        )

        # Prefer a position that is not exactly where she already is.
        target = random.choice(candidates[:max(1, len(candidates) - 1)])
        self.move_smoothly(target, 900)

    # ---------- Horn defense ----------

    def horn_rects(self):
        # Approximate horn zones for the existing chest-up reaction artwork.
        # These are local window coordinates and can be adjusted later if
        # the artwork framing changes.
        w = max(1, self.width())
        h = max(1, self.height())

        return [
            (int(w * 0.20), int(h * 0.02), int(w * 0.18), int(h * 0.23)),
            (int(w * 0.62), int(h * 0.02), int(w * 0.18), int(h * 0.23)),
        ]

    def cursor_near_horn(self):
        local = self.mapFromGlobal(QCursor.pos())

        for x, y, w, h in self.horn_rects():
            padding = 12
            if (
                x - padding <= local.x() <= x + w + padding
                and y - padding <= local.y() <= y + h + padding
            ):
                return True

        return False

    def check_horns(self):
        # Do not check for another horn hit while Saphira is already fleeing.
        if self.flee_animation is not None:
            return

        near = self.cursor_near_horn()

        if near and self.horn_armed:
            self.horn_armed = False
            self.horn_strike()

        elif not near:
            # The cursor must leave the horn area before another strike
            # can be registered.
            self.horn_armed = True

    def horn_reaction(self, strikes):
        # Different reactions depending on how many times
        # the user has touched Saphira's horns.
        reactions = {
            1: [
                "Hey! Don't touch my horns!",
                "E-Eek! My horns are sensitive!",
                "Hands off the horns!",
                "What are you doing?! Don't touch those!",
                "Hey! Those aren't handles!",
            ],
            2: [
                "I told you to stop touching my horns!",
                "Again?! Seriously?!",
                "H-Hey! I warned you!",
                "You're really testing my patience now...",
                "Stop poking my horns!",
            ],
        }

        if strikes >= self.HORN_MAX_STRIKES:
            return "THAT'S IT! I'm leaving before you touch them again!"

        options = reactions.get(strikes, reactions[2])
        return random.choice(options)

    def horn_strike(self):
        self.register_interaction()

        # Horn strikes are intentionally session-only.
        # This prevents state.json from causing an unexpected strike
        # count after Saphira is restarted.
        self.horn_strikes += 1
        strikes = self.horn_strikes

        self.state.data["horn_strikes"] = strikes
        self.state.data["activity"] = "fleeing"
        self.state.save()

        # React immediately when the horn is touched.
        reaction = self.horn_reaction(strikes)
        self.chat_box.append(f"<b>Saphira:</b> {reaction}")

        # Every horn strike restarts the 10-second countdown.
        # If no additional strike occurs for 10 seconds, the count
        # returns to zero AND the horn detector is re-armed.
        self.horn_reset_timer.start(self.HORN_RESET_MS)

        self.set_emotion("shocked")

        # Move away from the cursor while staying inside the screen.
        cursor = QCursor.pos()
        dx = self.x() + self.width() / 2 - cursor.x()
        dy = self.y() + self.height() / 2 - cursor.y()

        if abs(dx) < 1 and abs(dy) < 1:
            dx, dy = -1, -1

        length = max(1.0, (dx * dx + dy * dy) ** 0.5)
        target = QPoint(
            int(self.x() + dx / length * self.FLEE_DISTANCE),
            int(self.y() + dy / length * self.FLEE_DISTANCE),
        )

        if strikes >= self.HORN_MAX_STRIKES:
            # Third strike: flee, then exit.
            self.move_smoothly(target, self.FLEE_DURATION_MS)
            QTimer.singleShot(
                self.FLEE_DURATION_MS + 900,
                QApplication.quit,
            )
            return

        self.move_smoothly(target, self.FLEE_DURATION_MS)

    def reset_horn_strikes(self):
        # Reset both the visible/saved counter and the actual
        # in-memory horn defense state.
        self.horn_strikes = 0
        self.horn_armed = True

        self.state.data["horn_strikes"] = 0
        self.state.save()

    # ---------- Dragging / menus ----------

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.register_interaction()
            self.drag_offset = event.globalPosition().toPoint() - self.frameGeometry().topLeft()
            event.accept()
            return
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self.drag_offset is not None and event.buttons() & Qt.LeftButton:
            target = event.globalPosition().toPoint() - self.drag_offset
            safe = self.safe_position(target.x(), target.y())
            self.move(safe)
            event.accept()
            return
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.drag_offset = None
            self.save_preferred_position()
            event.accept()
            return
        super().mouseReleaseEvent(event)

    def mouseDoubleClickEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.chat_box.setVisible(not self.chat_box.isVisible())
            self.input_box.setVisible(not self.input_box.isVisible())
            self.talk_button.setVisible(not self.talk_button.isVisible())
            self.adjustSize()
            event.accept()
            return
        super().mouseDoubleClickEvent(event)

    def show_context_menu(self, pos):
        menu = QMenu(self)

        show_action = menu.addAction(
            "Hide Chat" if self.chat_box.isVisible() else "Show Chat"
        )
        show_action.triggered.connect(self.toggle_chat)

        menu.addSeparator()

        exit_action = menu.addAction("Exit Saphira")
        exit_action.triggered.connect(QApplication.quit)

        menu.exec(self.mapToGlobal(pos))

    def toggle_chat(self):
        visible = not self.chat_box.isVisible()
        self.chat_box.setVisible(visible)
        self.input_box.setVisible(visible)
        self.talk_button.setVisible(visible)
        self.adjustSize()

    def closeEvent(self, event):
        self.save_preferred_position()
        self.state.save()
        event.accept()
