from core.state import SaphiraState


class BrainWorker(QThread):
    finished = Signal(dict)
    failed = Signal(str)

    def __init__(self, brain, user_text=None, idle=False, context=""):
        super().__init__()
        self.brain = brain
        self.user_text = user_text
        self.idle = idle
        self.context = context

    def run(self):
        try:
            if self.idle:
                result = self.brain.idle_prompt(self.context)
            else:
                result = self.brain.reply(self.user_text)
            self.finished.emit(result)
        except Exception as exc:
            self.failed.emit(str(exc))


class SaphiraWindow(QWidget):
    """Desktop companion window with behavior state and lightweight autonomy."""

    IDLE_AFTER_MS = 30_000
    IDLE_SPEAK_AFTER_MS = 60_000
    HORN_RESET_MS = 10_000
    HORN_MAX_STRIKES = 3

    FLEE_DISTANCE = 220
    FLEE_DURATION_MS = 550

    # The images you already have. Do not rename them.
    REACTIONS = {
        "neutral": "neutral.png",
        "happy": "happy.png",
        "shocked": "shocked.png",
    }

    def __init__(self, brain, config):
        super().__init__()

        self.brain = brain
        self.config = config

        state_path = Path(__file__).resolve().parents[1] / "config" / "state.json"
        self.state = SaphiraState(state_path)

        self.drag_offset = None
        self.worker = None
        self.flee_animation = None
        self.last_interaction = time.monotonic()
        self.idle_started_at = None
        self.idle_spoke = False
        self.idle_moved = False
        # Horn defense is session-based.
        # Never allow an old saved strike count to carry into a new launch.
        self.horn_strikes = 0
        self.horn_armed = True

        self.horn_reset_timer = QTimer(self)
        self.horn_reset_timer.setSingleShot(True)
        self.horn_reset_timer.timeout.connect(self.reset_horn_strikes)
        self.horn_reset_timer.setSingleShot(True)
        self.horn_reset_timer.timeout.connect(self.reset_horn_strikes)

        # Horn strikes never carry across application restarts.
        self.state.data["horn_strikes"] = 0
        self.state.save()

        self.build_ui()
        self.load_saved_position()

        # Saphira always starts in her neutral expression.
        # Her position is remembered, but her temporary emotional state
        # should not carry over between launches.
        self.set_emotion("neutral")

        # Give the chat input focus when Saphira starts.
        self.input_box.setFocus()

        self.behavior_timer = QTimer(self)
        self.behavior_timer.timeout.connect(self.update_behavior)
        self.behavior_timer.start(250)

        self.horn_timer = QTimer(self)
        self.horn_timer.timeout.connect(self.check_horns)
        self.horn_timer.start(50)

    # ---------- UI ----------

