                color: white;
                border: 2px solid rgba(100, 160, 255, 170);
                border-radius: 10px;
                padding: 8px;
                font-size: 14px;
            }
        """)

        self.input_box = QLineEdit(self)
        self.input_box.setMinimumHeight(46)
        self.input_box.setPlaceholderText("Talk to Saphira...")
        self.input_box.setFocusPolicy(Qt.StrongFocus)
        self.input_box.setStyleSheet("""
            QLineEdit {
                background: rgba(20, 20, 32, 245);
                color: white;
                border: 2px solid rgba(100, 160, 255, 190);
                border-radius: 10px;
                padding: 8px 12px;
                font-size: 15px;
            }

            QLineEdit:focus {
                border: 2px solid rgba(130, 190, 255, 255);
                background: rgba(25, 25, 40, 250);
            }

            QLineEdit:disabled {
                color: rgba(255, 255, 255, 150);
            }
        """)
        self.input_box.returnPressed.connect(self.send_message)

        self.talk_button = QPushButton("Talk", self)
        self.talk_button.setMinimumHeight(46)
        self.talk_button.setMinimumWidth(80)
        self.talk_button.setStyleSheet("""
            QPushButton {
                background: rgba(35, 45, 75, 245);
                color: white;
                border: 2px solid rgba(100, 160, 255, 190);
                border-radius: 10px;
                padding: 8px 14px;
                font-size: 14px;
            }

            QPushButton:hover {
                background: rgba(50, 65, 100, 250);
                border: 2px solid rgba(130, 190, 255, 255);
            }

            QPushButton:pressed {
                background: rgba(25, 35, 60, 250);
            }

