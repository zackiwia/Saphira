import json
import re
import urllib.error
import urllib.request
from pathlib import Path

from memory.manager import MemoryManager


class SaphiraBrain:
    """Ollama-powered brain for Saphira."""

    ALLOWED_EMOTIONS = {"neutral", "happy", "shocked"}

    def __init__(self, config):
        self.base_url = config["ollama"]["url"].rstrip("/")
        self.model = config["ollama"]["model"]
        self.system_prompt = config["saphira"]["system_prompt"]
        self.history = []

        memory_path = Path(__file__).resolve().parents[1] / "memory" / "memories.json"
        self.memory = MemoryManager(memory_path)

    def _extract_json(self, text: str):
        if not text:
            return None

        text = text.strip()
        text = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", "", text)

        try:
            return json.loads(text)
        except json.JSONDecodeError:
            pass

        start = text.find("{")
        end = text.rfind("}")

        if start != -1 and end > start:
            try:
                return json.loads(text[start:end + 1])
            except json.JSONDecodeError:
                return None

        return None

    def _call_ollama(self, messages, temperature=0.8):
        payload = json.dumps({
            "model": self.model,
            "messages": messages,
            "stream": False,
            "format": "json",
            "options": {"temperature": temperature},
        }).encode("utf-8")

        request = urllib.request.Request(
            f"{self.base_url}/api/chat",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )

        with urllib.request.urlopen(request, timeout=120) as response:
            data = json.loads(response.read().decode("utf-8"))

        return data.get("message", {}).get("content", "")

    def _explicit_memory(self, user_text):
        patterns = [
            r"^\s*remember\s+(?:that\s+)?(.+?)\s*[.!?]?\s*$",
            r"^\s*please\s+remember\s+(?:that\s+)?(.+?)\s*[.!?]?\s*$",
            r"^\s*don't\s+forget\s+(?:that\s+)?(.+?)\s*[.!?]?\s*$",
            r"^\s*do\s+not\s+forget\s+(?:that\s+)?(.+?)\s*[.!?]?\s*$",
        ]

        for pattern in patterns:
            match = re.match(pattern, user_text, re.IGNORECASE)

            if match:
                memory = match.group(1).strip()

                if memory:
                    return memory

        return None

    def _decide_memory_action(self, memory_text):
        memories = self.memory.get_all()

        if not memories:
            return {
                "action": "add",
                "existing_memory": "",
                "memory": memory_text
            }

        memory_list = "\n".join(
            f"{index}: {memory}"
            for index, memory in enumerate(memories)
        )

        prompt = f"""
You are Saphira's memory manager.

A new personal fact has been detected from the user.

Your job is to decide what should happen to Saphira's existing memories.

NEW FACT:
{memory_text}

EXISTING MEMORIES:
{memory_list}

Choose exactly ONE action:

1. "add"
Use this when the new fact is genuinely new information that should be
stored separately.

2. "update"
Use this when the new fact replaces, changes, corrects, or supersedes
an existing memory.

3. "none"
Use this when the information is already represented by an existing
memory, is temporary, or is not useful as a long-term memory.

If using "update", identify the EXACT existing memory text that should
be replaced.

Return ONLY valid JSON:

{{
  "action": "add",
  "existing_memory": "",
  "memory": "{memory_text}"
}}
"""

        try:
            content = self._call_ollama(
                [{"role": "system", "content": prompt}],
                temperature=0.1
            )

            result = self._extract_json(content)

            if not isinstance(result, dict):
                return {
                    "action": "add",
                    "existing_memory": "",
                    "memory": memory_text
                }

            action = str(
                result.get("action", "add")
            ).lower().strip()

            existing_memory = str(
                result.get("existing_memory", "")
            ).strip()

            new_memory = str(
                result.get("memory", memory_text)
            ).strip()

            if action not in {"add", "update", "none"}:
                action = "add"

            if not new_memory and action != "none":
                new_memory = memory_text

            return {
                "action": action,
                "existing_memory": existing_memory,
                "memory": new_memory
            }

        except Exception:
            return {
                "action": "add",
                "existing_memory": "",
                "memory": memory_text
            }

    def _store_memory(self, memory_text):
        if not isinstance(memory_text, str):
            return "ignored"

        memory_text = memory_text.strip()

        if not memory_text:
            return "ignored"

        decision = self._decide_memory_action(memory_text)

        action = decision.get("action", "add")
        existing_memory = decision.get("existing_memory", "").strip()
        new_memory = decision.get("memory", memory_text).strip()

        if action == "none":
            return "ignored"

        if action == "update" and existing_memory:
            memories = self.memory.get_all()

            for index, existing in enumerate(memories):
                if existing == existing_memory:
                    if self.memory.update(index, new_memory):
                        return "updated"

            similar_index = self.memory.find_similar(existing_memory)

            if similar_index is not None:
                if self.memory.update(similar_index, new_memory):
                    return "updated"

        if self.memory.add_unique(new_memory):
            return "added"

        return "duplicate"

    def _handle_explicit_memory(self, user_text):
        memory_text = self._explicit_memory(user_text)

        if memory_text is None:
            return None

        result = self._store_memory(memory_text)

        if result in {"added", "updated"}:
            message = f"Got it. I'll remember that {memory_text}."
            emotion = "happy"
        elif result == "duplicate":
            message = "Hmph... I already remember that."
            emotion = "neutral"
        else:
            message = "Hmph... I couldn't save that memory."
            emotion = "neutral"

        self.history.append({
            "role": "user",
            "content": user_text
        })

        self.history.append({
            "role": "assistant",
            "content": message
        })

        return {
            "message": message,
            "emotion": emotion,
        }

    def _detect_auto_memory(self, user_text):
        prompt = f"""
You are Saphira's memory detector.

Decide whether the user's message contains a useful personal fact
that would reasonably help Saphira understand or remember the user
in future conversations.

Good candidates include:
- preferences
- favorite things
- hobbies
- ongoing projects
- important goals
- recurring activities
- useful personal circumstances
- names of important people, pets, or characters
- stable likes or dislikes

Do NOT select:
- random temporary statements
- ordinary conversation
- questions with no personal fact
- jokes
- greetings
- facts about unrelated public topics
- information that is obviously only relevant to this single message

Only identify information about the user or their ongoing context.

User message:
{user_text}

Return ONLY valid JSON in exactly this format:

{{
  "should_remember": true,
  "memory": "short clear description of the useful fact"
}}

If there is nothing worth remembering:

{{
  "should_remember": false,
  "memory": ""
}}
"""

        try:
            content = self._call_ollama(
                [{"role": "system", "content": prompt}],
                temperature=0.1
            )

            result = self._extract_json(content)

            if not isinstance(result, dict):
                return {
                    "should_remember": False,
                    "memory": ""
                }

            should_remember = result.get("should_remember", False)
            memory = str(result.get("memory", "")).strip()

            return {
                "should_remember": bool(should_remember) and bool(memory),
                "memory": memory
            }

        except Exception:
            return {
                "should_remember": False,
                "memory": ""
            }

    def _retrieve_memories(self, user_text, limit=5):
        """
        Find memories that are relevant to the current user message.

        This first performs a lightweight word-overlap search so we do not
        send every saved memory to Ollama on every conversation turn.
        """

        memories = self.memory.get_all()

        if not memories:
            return []

        user_words = set(
            re.findall(r"[a-z0-9]+", user_text.lower())
        )

        if not user_words:
            return []

        scored = []

        for index, memory in enumerate(memories):
            memory_words = set(
                re.findall(r"[a-z0-9]+", memory.lower())
            )

            if not memory_words:
                continue

            overlap = user_words & memory_words

            if not overlap:
                continue

            score = len(overlap) / len(memory_words)

            scored.append((score, index, memory))

        scored.sort(
            key=lambda item: (item[0], item[1]),
            reverse=True
        )

        return [
            memory
            for _, _, memory in scored[:limit]
        ]

    def _build_memory_context(self, user_text):
        memories = self._retrieve_memories(user_text)

        if not memories:
            return ""

        memory_lines = "\n".join(
            f"- {memory}"
            for memory in memories
        )

        return f"""
Relevant long-term memories about the user:

{memory_lines}

Use these memories when they are relevant to the user's message.
Do not mention the memory system itself unless the user asks about it.
Do not invent information that is not present in the memories.
"""


    def _memory_view_request(self, user_text):
        """
        Detect requests asking Saphira what she remembers.
        Returns True when the user wants to see stored memories.
        """

        text = user_text.lower().strip()

        patterns = [
            r"^what do you remember(?: about me)?[?.!]*$",
            r"^what do you remember about me[?.!]*$",
            r"^tell me what you remember(?: about me)?[?.!]*$",
            r"^what do you know about me[?.!]*$",
            r"^what memories do you have(?: about me)?[?.!]*$",
            r"^show me what you remember[?.!]*$",
        ]

        return any(
            re.match(pattern, text, re.IGNORECASE)
            for pattern in patterns
        )

    def _handle_memory_view(self, user_text):
        """
        Return a readable response containing Saphira's stored memories.
        """

        if not self._memory_view_request(user_text):
            return None

        memories = self.memory.get_all()

        self.history.append({
            "role": "user",
            "content": user_text
        })

        if not memories:
            message = (
                "Hmph... I don't have any long-term memories saved yet."
            )
        else:
            memory_lines = "\n".join(
                f"{index + 1}. {memory}"
                for index, memory in enumerate(memories)
            )

            message = (
                "Here's what I remember about you:\n\n"
                f"{memory_lines}"
            )

        self.history.append({
            "role": "assistant",
            "content": message
        })

        return {
            "message": message,
            "emotion": "neutral"
        }

    def reply(self, user_text):
        memory_view = self._handle_memory_view(user_text)

        if memory_view is not None:
            return memory_view

        explicit_memory = self._handle_explicit_memory(user_text)

        if explicit_memory is not None:
            return explicit_memory

        auto_memory = self._detect_auto_memory(user_text)

        memory_action = "none"

        if auto_memory.get("should_remember"):
            memory_text = auto_memory.get("memory", "").strip()

            if memory_text:
                memory_action = self._store_memory(memory_text)

        self.history.append({
            "role": "user",
            "content": user_text
        })

        memory_context = self._build_memory_context(user_text)

        system_content = self.system_prompt

        if memory_context:
            system_content += "\n\n" + memory_context

        messages = [
            {
                "role": "system",
                "content": system_content
            }
        ] + self.history[-12:]

        try:
            content = self._call_ollama(messages)
            result = self._extract_json(content)

            if not isinstance(result, dict):
                result = {
                    "message": "Hmph... I couldn't understand that response.",
                    "emotion": "neutral",
                }

            message = str(result.get("message", "...")).strip()

            emotion = str(
                result.get("emotion", "neutral")
            ).lower().strip()

            if emotion not in self.ALLOWED_EMOTIONS:
                emotion = "neutral"

            self.history.append({
                "role": "assistant",
                "content": message
            })

            return {
                "message": message,
                "emotion": emotion,
                "memory_candidate": auto_memory,
                "memory_action": memory_action,
                "retrieved_memories": self._retrieve_memories(user_text)
            }

        except urllib.error.URLError as exc:
            return {
                "message": f"I can't reach Ollama right now: {exc}",
                "emotion": "neutral",
                "memory_candidate": auto_memory,
                "memory_action": memory_action,
                "retrieved_memories": self._retrieve_memories(user_text)
            }

        except Exception as exc:
            return {
                "message": f"Something went wrong: {exc}",
                "emotion": "neutral",
                "memory_candidate": auto_memory,
                "memory_action": memory_action,
                "retrieved_memories": self._retrieve_memories(user_text)
            }

    def idle_prompt(self, context=""):
        prompt = f"""
You are Saphira, a mildly tsundere dragon-girl desktop companion.
The user has not interacted with you for about a minute.

Recent conversation/context:
{context or "(No useful recent context.)"}

Start a natural, short conversation on your own.
Prefer a topic related to what the user was recently talking about, playing,
working on, or doing. Do not claim to see the user's screen; you do not have
vision yet. If there is no useful context, choose a light everyday topic.

Return ONLY valid JSON:
{{
  "message": "short thing Saphira would say",
  "emotion": "neutral|happy|shocked"
}}
"""

        try:
            content = self._call_ollama(
                [{"role": "system", "content": prompt}],
                temperature=0.95
            )

            result = self._extract_json(content)

            if not isinstance(result, dict):
                return {
                    "message": "You're awfully quiet over there...",
                    "emotion": "neutral"
                }

            emotion = str(
                result.get("emotion", "neutral")
            ).lower().strip()

            if emotion not in self.ALLOWED_EMOTIONS:
                emotion = "neutral"

            return {
                "message": str(
                    result.get(
                        "message",
                        "You're awfully quiet over there..."
                    )
                ).strip(),
                "emotion": emotion,
            }

        except Exception:
            return {
                "message": "You're awfully quiet over there... what are you doing?",
                "emotion": "neutral",
            }

