import threading
import time

from vision.screen import SaphiraVision


class BackgroundVision:
    """
    Runs Saphira's vision system in a background thread.

    Vision observations are temporary. They are kept in memory only
    and are replaced whenever a newer observation is available.
    """

    def __init__(self, config, interval_seconds=15):
        self.config = config
        self.interval_seconds = interval_seconds

        self.vision = SaphiraVision(config)

        self.latest_observation = None
        self.last_capture_time = None
        self.last_duration = None

        self.running = False
        self.thread = None

        self._lock = threading.Lock()

    def start(self):
        if self.running:
            return

        self.running = True

        self.thread = threading.Thread(
            target=self._run,
            daemon=True
        )

        self.thread.start()

    def stop(self):
        self.running = False

    def get_latest_observation(self):
        with self._lock:
            return self.latest_observation

    def get_status(self):
        with self._lock:
            return {
                "running": self.running,
                "last_capture_time": self.last_capture_time,
                "last_duration": self.last_duration,
                "has_observation": self.latest_observation is not None
            }

    def _run(self):
        while self.running:
            started = time.time()

            try:
                print("")
                print("BACKGROUND VISION: Capturing screen...")

                observation = self.vision.observe_screen()

                duration = time.time() - started

                with self._lock:
                    self.latest_observation = observation
                    self.last_capture_time = time.time()
                    self.last_duration = duration

                print(
                    f"BACKGROUND VISION: Completed in {duration:.1f}s"
                )

                print("BACKGROUND VISION:")
                print(observation)

            except Exception as e:
                duration = time.time() - started

                with self._lock:
                    self.last_duration = duration

                print(
                    f"BACKGROUND VISION ERROR: {e}"
                )

            # Wait between scans without blocking the main program.
            #
            # Checking once every 15 seconds is deliberately conservative
            # for the first performance test.
            remaining = self.interval_seconds

            while self.running and remaining > 0:
                time.sleep(min(1, remaining))
                remaining -= 1
